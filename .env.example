# ──────────────────────────────────────────────────────────────
# Arunami prototype — environment
#
# LEAVE THIS UNSET to run in MOCK mode (in-memory + localStorage,
# no backend needed). The app runs instantly with seeded demo data.
#
# To use REAL Firebase: copy this file to `.env.local`, fill in your
# project's web-app config, and set VITE_USE_FIREBASE=true.
# Nothing else in the code changes — the data layer switches adapters.
# ──────────────────────────────────────────────────────────────

VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
