rules_version = '2';

// Arunami — Storage rules (for FB-E file uploads: proofs, KYC docs).
// Prototype: signed-in users only. Tighten per-path in production.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
